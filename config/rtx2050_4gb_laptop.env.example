# Perfil calibrado para laptop NVIDIA GeForce RTX 2050 (4 GB VRAM) + 24 GB RAM
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
EXTRACTAIA_MODEL=qwen2.5vl:3b

# Registro automatico en el pool interno de ExtractaIA (copiar a .env local, nunca subir .env a Git)
GPU_NODE_ID=laptop-josue-rtx2050
GPU_NODE_LABEL=Laptop Josue RTX 2050 (4 GB)
GPU_NODE_PRIORITY=20
EXTRACTAIA_REGISTER_URL=https://extractaia.dburela.com
GPU_NODE_TOKEN=REEMPLAZAR_POR_TOKEN_OPERADOR
